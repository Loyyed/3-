            },
            {
              "card": "R8c387d2da2f6",
              "field": "evidence"
            },
            {
              "card": "R8c387d2da2f6",
              "field": "alternative"
            },
            {
              "card": "R8c387d2da2f6",
              "field": "variables"
            },
            {
              "card": "R8c387d2da2f6",
              "field": "gap"
            }
          ]
        },
        {
          "text": "改善路径：2026收入34,663.86、分析经营利润14,454.29、合并净利10,851.18；2027收入41,925.94、分析经营利润17,608.90、合并净利13,575.20；2028收入50,709.43、分析经营利润21,297.96、合并净利16,419.21。触发条件：新品接续和成熟店回报恢复。",
          "anchors": [
            {
