              "field": "claim"
            },
            {
              "card": "R3fe807f7f8f2",
              "field": "evidence"
            },
            {
              "card": "R3fe807f7f8f2",
              "field": "variables"
            },
            {
              "card": "R3fe807f7f8f2",
              "field": "gap"
            }
          ]
        },
        {
          "text": "改善 手术增长17%，定价影响3%，装机服务同步增长。2026年收入12,074.42、经营EBIT4,080.34、条件FCFF2,582.05；2027年收入13,962.76、经营EBIT5,026.59、条件FCFF3,197.59；2028年收入16,151.04、经营EBIT5,814.37、条件FCFF3,697.68。金额为百万USD。",
