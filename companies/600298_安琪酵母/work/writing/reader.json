              "card": "Rc307bcec6202",
              "field": "variables"
            },
            {
              "card": "Rc307bcec6202",
              "field": "gap"
            }
          ]
        }
      ]
    },
    {
      "title": "优势的经营证据与竞争分歧",
      "paragraphs": [
        {
          "text": "应用技术、本地化生产和客户认证的优势假设已有产品毛利改善作经营支持：2025酵母及深加工毛利率32.21%，比同期提高2.67个百分点，销量也增加。与此同时糖业毛利率为-4.86%，新业务扩张会稀释组合回报。存量酵母效率改善与新增工厂贡献尚无独立资本及产出队列，不能把合并利润增量分配给新项目。",
          "anchors": [
            {
              "card": "Ra9f2c23c0275",
              "field": "claim"
            },
            {
              "card": "Ra9f2c23c0275",
              "field": "evidence"
            },
            {
              "card": "Ra9f2c23c0275",
              "field": "alternative"
            },
            {
              "card": "Ra9f2c23c0275",
              "field": "variables"
            },
            {
              "card": "Ra9f2c23c0275",
              "field": "gap"
            }
          ]
        },
        {
          "text": "解释A：应用拓展、本地化服务和存量工艺效率共同提高可销售量，新厂认证完成后提升固定成本吸收。 解释B：低成本原料和地区组合暂时抬高毛利，新增产能回收较慢，融资及营运资金占用吸收经营改善。",
          "anchors": [
            {
              "card": "Ra9f2c23c0275",
              "field": "claim"
            },
            {
              "card": "Ra9f2c23c0275",
              "field": "evidence"
            },
            {
              "card": "Ra9f2c23c0275",
              "field": "alternative"
            },
            {
              "card": "Ra9f2c23c0275",
              "field": "variables"
            },
            {
              "card": "Ra9f2c23c0275",
              "field": "gap"
            }
          ]
        },
        {
          "text": "销量增长快于酵母收入，组均价/结构下降；糖业仍亏毛利，2026财务费用增加而现金流未同步增长。这些是对高新增回报叙事的实际挑战，尚未单独识别新厂的项目回报率。",
          "anchors": [
            {
              "card": "Ra9f2c23c0275",
              "field": "claim"
            },
            {
              "card": "Ra9f2c23c0275",
              "field": "evidence"
            },
            {
              "card": "Ra9f2c23c0275",
              "field": "alternative"
            },
            {
              "card": "Ra9f2c23c0275",
              "field": "variables"
            },
            {
              "card": "Ra9f2c23c0275",
              "field": "gap"
            }
          ]
        },
        {
          "text": "观察海外同币种净价、糖蜜与能源单位耗用、新厂产销率和认证进度、存量厂与新厂分别的投入和营运余额。若酵母毛利下降并伴新厂低利用率、库存占用上升，应降低新增量和毛利假设；若原料回升后毛利仍稳定且现金回款改善，效率解释获得更强支持。",
          "anchors": [
            {
              "card": "Ra9f2c23c0275",
              "field": "claim"
            },
            {
              "card": "Ra9f2c23c0275",
              "field": "evidence"
            },
            {
              "card": "Ra9f2c23c0275",
              "field": "alternative"
            },
            {
              "card": "Ra9f2c23c0275",
              "field": "variables"
            },
            {
              "card": "Ra9f2c23c0275",
              "field": "gap"
            }
          ]
        }
      ]
    },
    {
      "title": "2026剩余期间与2027—2028条件预测",
      "paragraphs": [
        {
          "text": "基准路径2027—28可销售量/应用指数+10%、组净价-0.5%，综合毛利率25%、销售5.7%、管理3.4%、研发4.1%；压力路径量+4%、价-2.5%、毛利23%；改善路径量+14%、价+0.5%、毛利27%。2026剩余季度以前一年同季收入为基数，对量价增幅折半。模型预测合并净利润；少数股东归属和包材范围保持独立，未伪造归母预测。",
          "anchors": [
            {
              "card": "R29373d7bc0f1",
              "field": "claim"
            },
            {
              "card": "R29373d7bc0f1",
              "field": "evidence"
