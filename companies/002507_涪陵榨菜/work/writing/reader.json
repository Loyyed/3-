              "field": "variables"
            },
            {
              "card": "R48ccbb2a4ad6",
              "field": "gap"
            }
          ]
        },
        {
          "text": "压力与改善路径的参数、历史锚和触发条件均存forecast-input.json；任何实际证据改变驱动，应修订参数并重算。",
          "anchors": [
            {
              "card": "R48ccbb2a4ad6",
