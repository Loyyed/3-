              "card": "R9b91e4658392",
              "field": "gap"
            }
          ]
        },
        {
          "text": "基准路径：2026收入2,490.55、分析经营利润1,247.96、合并净利1,435.81；2027收入2,796.14、分析经营利润1,417.65、合并净利1,434.51；2028收入3,139.23、分析经营利润1,591.59、合并净利1,592.47。触发条件：硬件渗透继续，研发费率约13.5%。",
          "anchors": [
            {
