      "headings": [
        {
          "line": 16,
          "text": "# Lec05｜叙事与估值 Part 4"
        },
        {
          "line": 22,
          "text": "## 六、折现率与稳定期：从年度现金流到经营资产价值"
        },
        {
          "line": 28,
          "text": "### 6.1 资本成本（折现率）：不能由研究者任意设定"
        },
        {
          "line": 30,
          "text": "#### 6.1.1 为什么未来现金需要折现？"
        },
        {
          "line": 46,
          "text": "#### 6.1.2 根据现金流类型确定折现率"
        },
        {
          "line": 50,
          "text": "### 6.2 股权资本成本：无风险利率、（股票）市场风险溢价与贝塔系数"
        },
        {
          "line": 52,
          "text": "#### 6.2.1 运用资本资产定价模型估计股权资本成本"
        },
        {
          "line": 77,
          "text": "#### 6.2.2 无风险利率的选择：与现金流的计价货币和期限相匹配"
        },
        {
          "line": 87,
          "text": "#### 6.2.3 （股票）市场风险溢价与贝塔系数的估计"
        },
        {
          "line": 97,
          "text": "#### 6.2.4 自下而上估计贝塔（Bottom-up Beta）：从可比业务出发"
        },
        {
          "line": 157,
          "text": "### 6.3 WACC：债务成本、税盾和资本结构需综合考虑"
        },
        {
          "line": 159,
          "text": "#### 6.3.1 债务成本是==当前边际成本==，不是历史票面利率"
        },
        {
          "line": 170,
          "text": "#### 6.3.2 税盾与税后债务成本"
        },
        {
          "line": 204,
          "text": "#### 6.3.3 为什么不能直接用股权与债务的账面价值？"
        },
        {
          "line": 216,
          "text": "### 6.4 现金流预测与折现率中风险的处理"
        },
        {
          "line": 220,
          "text": "#### 6.4.1 现金流预测应考虑不同经营结果"
        },
        {
          "line": 232,
          "text": "#### 6.4.2 考虑可能损失后，仍需估计风险补偿"
        },
        {
          "line": 240,
          "text": "#### 6.4.3 停止经营的可能性应单独分析"
        },
        {
          "line": 248,
          "text": "### 6.5 显性预测期的确定与稳定期的判断"
        },
        {
          "line": 250,
          "text": "#### 6.5.1 区分显性预测期、稳定期与竞争优势持续期"
        },
        {
          "line": 262,
          "text": "#### 6.5.2 判断企业进入稳定期的主要条件"
        },
        {
          "line": 278,
          "text": "### 6.6 终值的计算与折现"
        },
        {
          "line": 280,
          "text": "#### 6.6.1 稳定增长条件下的终值公式"
        },
        {
          "line": 300,
          "text": "#### 6.6.2 将终值折现至估值时点"
        },
        {
          "line": 325,
          "text": "#### 6.6.3 如何确定稳定期的长期增长率"
        },
        {
          "line": 337,
          "text": "### 6.7 稳定期增长与再投资的关系"
        },
        {
          "line": 339,
          "text": "#### 6.7.1 根据增长率和投资回报率确定再投资需求"
        },
        {
          "line": 397,
          "text": "#### 6.7.2 教学案例：考虑再投资需求的终值计算（时刻铭记增长的代价）"
        },
        {
          "line": 429,
          "text": "#### 6.7.3 显性预测期与稳定期之间的再投资衔接"
        },
        {
          "line": 444,
          "text": "#### 6.7.4 增长创造价值的条件"
        },
        {
          "line": 473,
          "text": "### 6.8 竞争优势持续期与长期超额回报"
        },
        {
          "line": 475,
          "text": "#### 6.8.1 稳定期的超额回报假设需要长期竞争优势支持"
        },
        {
          "line": 483,
          "text": "#### 6.8.2 将新增投资回报率的下降反映在经营预测中"
        },
        {
          "line": 503,
          "text": "#### 6.8.3 竞争优势证据与估值假设的对应关系"
        },
        {
          "line": 514,
          "text": "### 6.9 现金流现值与终值占比"
        },
        {
          "line": 516,
          "text": "#### 6.9.1 计算显性预测期现金流的现值"
        },
        {
          "line": 553,
          "text": "#### 6.9.2 计算终值现值及其占经营资产价值的比重"
        },
        {
          "line": 589,
          "text": "#### 6.9.3 敏感性分析应同时考虑增长与再投资的变化"
        },
        {
          "line": 615,
          "text": "### 6.10 实践操作：编制资本成本与稳定期假设表"
        },
        {
          "line": 617,
          "text": "#### 6.10.1 记录参数的估计依据和采用理由"
        },
        {
          "line": 647,
          "text": "#### 6.10.2 在电子表格中计算逐期折现因子"
        },
        {
          "line": 662,
          "text": "#### 6.10.3 单独计算终值，再与对应的显性预测期衔接"
        },
        {
          "line": 695,
          "text": "#### 6.10.4 使用 Agent 辅助复算，并由人工判断假设是否合理"
        }
      ],
