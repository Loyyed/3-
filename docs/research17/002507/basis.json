  "judgments": [
    {
      "question": "首选判断",
      "judgment": "品牌带来的重复购买和渠道覆盖仍能支撑现金。按阶段 16 经营路径，11.42 元低于基准 15.09 元。应以新基地带来的净增吨数和直销现金贡献维持这个判断。",
      "tag": "研究判断"
    },
    {
      "question": "最强反方",
      "judgment": "直销放量可能伴随赊销和重复产能。集团前三季销货收现 2,156.74 百万元，上年同期 2,117.13。9 月应收 143.58 百万元，上年同月 120.88。渠道间回款与销售费用分配仍待核。",
      "tag": "研究判断"
    },
    {
      "question": "现价对应的经营预期",
      "judgment": "固定基准销量、价格、折现率和权益桥，11.42 元对应稳定营业利润率 15.86%、稳定 EBIT 511.64 百万元、FCFF 333.90 百万元。利润率搜索范围为 2%–80%。",
      "tag": "研究判断"
    },
    {
      "question": "翻转条件",
      "judgment": "上半年直销新增毛利 21.09 百万元。给定可归属贸易营运资本和基地净现金购建各 5 百万元，直销至多承担 11.09 百万元新增销售现金费用，相当于集团销售费用增量的 32.28%。分到集团增量的一半时，直销增量税前现金约 -6.09 百万元。新基地利用率 35% 时，将新基地产出中替代原产出的份额由 50% 调至 80%，未扣营运资本、未计旧线节约的现金从 +77.55 降至 −28.98 百万元。若渠道现金持续为负且基地净新增迟迟不能覆盖资本开支，采用 11.00 元压力路径。",
      "tag": "研究判断"
    },
    {
      "question": "下次可核对的公开指标",
      "judgment": "下一期年报/中报分销售模式毛利、销售费用、经营收现与应收，对照募投进度、试产和旧线退出。出货到回款的归因需要渠道级应收及相关费用。",
      "tag": "研究判断"
    }
  ],
